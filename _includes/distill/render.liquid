<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/al-folio-distill.css' | relative_url | bust_file_cache }}">

    <!-- Distill js (vendored + integrity-pinned; see assets/js/distillpub/provenance.json) -->
    {% al_folio_distill_runtime_scripts %}
    <link rel="stylesheet" href="{{ '/assets/css/seminar.css' | relative_url }}">
    {% if page._styles %}
      <!-- Page/Post style -->
      <style type="text/css">
        {{ page._styles }}
      </style>
    {% endif %}
  </head>

  <body class="seminar-site {% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <d-front-matter>
      <script async type="text/json">
        {
              "title": {{ page.title | jsonify }},
              "description": {{ page.description | default: page.hook | jsonify }},
              "published": "{{ page.date | date: '%B %d, %Y' }}",
              "authors": [
                {% if page.student_author %}
                {
                  "author": {{ page.student_author | jsonify }},
                  "affiliations": [{"name": {{ page.affiliation | default: site.data.seminar.university | jsonify }}}]
                }
                {% else %}
                {% for author in page.authors %}
                {
                  "author": "{{ author.name }}",
                  "authorURL": "{{ author.url }}",
                  "affiliations": [
                    {
                      "name": "{{ author.affiliations.name }}",
                      "url": "{{ author.affiliations.url }}"
                    }
                  ]
                }{% if forloop.last == false %},{% endif %}
                {% endfor %}
                {% endif %}
              ],
              "katex": {
                "delimiters": [
                  {
                    "left": "$",
                    "right": "$",
                    "display": false
                  },
                  {
                    "left": "$$",
                    "right": "$$",
                    "display": true
                  }
                ]
              }
            }
      </script>
    </d-front-matter>

    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <main id="main-content" class="post distill">
      <d-title>
        <h1>{{ page.title | escape }}</h1>
        {% unless page.status == 'forthcoming' %}
          <p>{{ page.hook | default: page.description | escape }}</p>
        {% endunless %}
        {% if page.seminar %}
          {% unless page.status == 'forthcoming' %}
            <p class="seminar-byline">
              {% if page.student_author -%}
                {{- page.student_author | escape -}}
                {% if page.supervisor and page.supervisor != '' %}
                  <br>
                  Supervisor: {{ page.supervisor | escape -}}
                {% endif %}
              {%- elsif page.authors -%}
                {{- page.authors | map: 'name' | join: ', ' | escape -}}
                {%- if page.distill_demo %} (example authors){% endif -%}
              {%- endif %}
            </p>
            <p class="seminar-context">{{ site.data.seminar.name | escape }} · {{ site.data.seminar.edition | escape }}</p>
          {% endunless %}
          <p class="seminar-topic">{% include seminar/paper-metadata.liquid article=page %}</p>
          {% if page.paper_url or page.code_url or page.project_url %}
            <p class="seminar-links">
              {% if page.paper_url -%}
                <a href="{{ page.paper_url | relative_url }}">Paper</a>
              {%- endif %}
              {% if page.code_url %}
                {% if page.paper_url %} · {% endif -%}
                <a href="{{ page.code_url | relative_url }}">Code</a>
              {%- endif %}
              {% if page.project_url %}
                {% if page.paper_url or page.code_url %} · {% endif -%}
                <a href="{{ page.project_url | relative_url }}">Project page</a>
              {%- endif %}
            </p>
          {% endif %}
        {% endif %}
      </d-title>
      {% unless page.seminar -%}
        {%- if page.authors %}<d-byline></d-byline>{% endif -%}
      {%- endunless %}

      <d-article>
        {% if page.example %}
          <p class="seminar-secondary">Authoring example · Not a student submission</p>
        {% endif %}
        {% if page.toc and page.toc.size > 0 %}
          <d-contents>
            <nav class="l-text figcaption" aria-label="Article sections">
              <h3>Contents</h3>
              {% for section in page.toc %}
                <div>
                  <a href="#{{ section.name | slugify }}">{{ section.name }}</a>
                </div>
                {% if section.subsections %}
                  <ul>
                    {% for subsection in section.subsections %}
                      <li>
                        <a href="#{{ subsection.name | slugify }}">{{ subsection.name }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              {% endfor %}
            </nav>
          </d-contents>

        {% elsif page.toc == true %}
          <d-contents>
            <nav class="l-text figcaption" aria-label="Article sections">
              <h3>Contents</h3>
              {% toc %}
            </nav>
          </d-contents>
        {% endif %}

        {{ content }}
      </d-article>

      <d-appendix
        {% unless page.bibliography or content contains '<d-footnote' %}
          hidden
        {% endunless %}
      >
        <d-footnote-list></d-footnote-list>
        <d-citation-list></d-citation-list>
      </d-appendix>
      {% if page.bibliography -%}
        <d-bibliography src="{{ page.bibliography | prepend: '/assets/bibliography/' | relative_url }}"></d-bibliography>
      {%- endif %}

      {% if page.seminar -%}
        <d-article class="seminar-endmatter">{% include seminar/article-footer.liquid %}</d-article>
      {%- endif %}
    </main>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include distill/scripts.liquid %}
  </body>
</html>
