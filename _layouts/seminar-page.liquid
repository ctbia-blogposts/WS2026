<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    {% include head.liquid %}
    <link rel="stylesheet" href="{{ '/assets/css/seminar.css' | relative_url }}">
  </head>
  <body class="seminar-site">
    {% include header.liquid %}
    <main id="main-content" class="container seminar-main">
      {% unless page.home %}
        <header class="post-header">
          <h1 class="post-title">{{ page.title | escape }}</h1>
        </header>
      {% endunless %}
      {{ content }}
    </main>
    {% include footer.liquid %}
    {% include scripts.liquid %}
  </body>
</html>
